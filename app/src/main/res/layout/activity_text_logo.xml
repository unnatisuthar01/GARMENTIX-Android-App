<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F6"
    tools:context=".TextLogoActivity">

    <!-- TOP BAR -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginTop="15dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="5dp"
            android:src="@drawable/ic_backarrow"
            android:contentDescription="Back"
            app:tint="#111827" />

        <TextView
            android:id="@+id/txtCustomizeTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:text="Text/Logo"
            android:textColor="#111827"
            android:textSize="20sp"
            android:textStyle="bold" />

    </RelativeLayout>


    <!-- MAIN SCROLL -->
    <ScrollView
        android:id="@+id/textLogoScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/textLogoMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- TEXT / LOGO TABS -->
            <LinearLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tabText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="#C9A227"
                    android:gravity="center"
                    android:text="Text"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabLogo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="Logo"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ENTER TEXT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter Text"
                android:textColor="#111827"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edtText"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#FFFFFF"
                android:hint="Enter your text..."
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="14sp"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnRemoveText"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="end"
                android:text="Remove Text"
                android:textAllCaps="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSelectLogo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Add Logo from Gallery"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnRemoveLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:text="Remove Logo"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Logo size"
                android:textColor="#111827"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekLogoSize"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:max="150"
                android:progress="50" />


            <!-- FONT STYLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Font Style"
                android:textColor="#111827"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/fontStyleLayout"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fontClassic"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="Classic"
                    android:textColor="#111827"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/fontElegant"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="Elegant"
                    android:textColor="#111827"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/fontModern"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="Modern"
                    android:textColor="#111827"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/fontBold"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="Bold"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- TEXT COLOR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Text Color"
                android:textColor="#111827"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/colorLayout"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/colorBlack"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:background="#111827"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/colorGold"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:background="#C9A227" />

                <TextView
                    android:id="@+id/colorPink"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:background="#EC4899" />

                <TextView
                    android:id="@+id/colorPurple"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:background="#9333EA" />

                <TextView
                    android:id="@+id/colorBlue"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:background="#3B82F6" />

                <TextView
                    android:id="@+id/colorGreen"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="#22C55E" />

            </LinearLayout>


            <!-- TEXT SIZE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Text Size"
                android:textColor="#111827"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp" />

            <SeekBar
                android:id="@+id/seekTextSize"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:max="50"
                android:progress="20" />

            <TextView
                android:id="@+id/txtTextSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Size: 30"
                android:textColor="#6B7280"
                android:textSize="12sp" />


            <!-- ROTATION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rotation"
                android:textColor="#111827"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp" />

            <SeekBar
                android:id="@+id/seekRotation"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:max="360"
                android:progress="0" />

            <TextView
                android:id="@+id/txtRotationValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rotation: 0°"
                android:textColor="#6B7280"
                android:textSize="12sp" />


            <!-- PREVIEW -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preview"
                android:textColor="#111827"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <RelativeLayout
                android:id="@+id/previewBox"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:background="#FFFFFF">

                <TextView
                    android:id="@+id/txtPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Your Text"
                    android:textColor="#111827"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgLogoPreview"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Logo preview"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

            </RelativeLayout>


            <!-- APPLY BUTTON -->
            <Button
                android:id="@+id/btnApply"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#C9A227"
                android:text="Apply"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</RelativeLayout>