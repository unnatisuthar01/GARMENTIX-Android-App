<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#FAF9F6"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FabricActivity">

    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_backarrow"
            app:tint="#111827"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Fabric"
            android:textColor="#111827"
            android:textSize="25sp"
            android:textStyle="bold"/>

    </RelativeLayout>
    <LinearLayout
        android:id="@+id/mainFabricArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topBar"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">
        <ScrollView
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingEnd="8dp">
            
            <TextView
                android:id="@+id/categoryAll"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="5dp"
                android:background="#111827"
                android:gravity="center"
                android:text="ALL"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/categoryCotton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="5dp"
                android:gravity="center"
                android:textColor="#374151"
                android:text="Cotton"
                android:textStyle="bold"
                android:textSize="12sp"/>
                <TextView
                    android:id="@+id/categorySilk"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:textColor="#374151"
                    android:text="Silk"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/categoryLinen"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:textColor="#374151"
                    android:text="Linen"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/categoryDenim"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:textColor="#374151"
                    android:text="Denim"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/categorySatin"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:textColor="#374151"
                    android:text="Satin"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/categoryVelvet"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:textColor="#374151"
                    android:text="Velvet"
                    android:textStyle="bold"
                    android:textSize="12sp"/>
                <TextView
                android:id="@+id/categoryRayon"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:textColor="#374151"
                android:text="Rayon"
                android:textStyle="bold"
                android:textSize="12sp"/>
                <TextView
                android:id="@+id/categoryGeorgette"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:textColor="#374151"
                android:text="Georgette"
                android:textStyle="bold"
                android:textSize="12sp"/>
                <TextView
                android:id="@+id/categoryChiffon"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:textColor="#374151"
                android:text="Chiffon"
                android:textStyle="bold"
                android:textSize="12sp"/>
            </LinearLayout>
        </ScrollView>
        <View
            android:layout_width="10dp"
            android:layout_height="match_parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFabric"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="2dp"
            android:scrollbars="none"/>
    </LinearLayout>
    <TextView
        android:id="@+id/txtNoFabrics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:gravity="center"
        android:text="No fabric options found."
        android:textColor="#6B7280"
        android:visibility="gone" />
</RelativeLayout>