<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:background="#FAF8F5"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="25dp"
    tools:context=".templatesActivity"
    android:fitsSystemWindows="false">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_backarrow"
            android:clickable="true"
            android:focusable="true"
            app:tint="#111827"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Templates"
            android:textColor="#111827"
            android:textSize="25sp"
            android:layout_gravity="center_horizontal"
            android:textStyle="bold"/>
    </RelativeLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">


            <TextView
                android:id="@+id/tabAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/bg_gold_button"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="ALL"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tabKurti"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="Kurti"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tabTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text=" Top "
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tabGrown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="Gown"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tabDress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="Dress"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tabLehenga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="Lehenga"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tabShirt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="Shirt"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/txtNoTemplates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="No artwork is available for this category yet."
        android:textColor="#6B7280"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTemplates"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
       android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clipToPadding="false" />


</LinearLayout>